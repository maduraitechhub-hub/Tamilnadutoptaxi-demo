# Hostinger (or your provider) SMTP — use the mailbox that sends mail (often hello@tamilnadudroptaxi.com)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Use false for port 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=hello@tamilnadudroptaxi.com
SMTP_PASS=your-mailbox-password

# Recipient (defaults to hello@tamilnadudroptaxi.com if omitted)
MAIL_TO=hello@tamilnadudroptaxi.com

# From header (defaults to TamilNadu Drop Taxi <SMTP_USER>)
# MAIL_FROM=TamilNadu Drop Taxi <hello@tamilnadudroptaxi.com>

# Optional: public site URL for metadata (see lib/site.js)
# NEXT_PUBLIC_SITE_URL=https://tamilnadudroptaxi.com
